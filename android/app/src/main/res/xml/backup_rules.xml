<?xml version="1.0" encoding="utf-8"?><!--
   Auto-backup rules: exclude sensitive data from cloud backup (Google Drive).
   - kid_mode_prefs.xml  : kid-mode PIN (even encrypted, avoid cloud copies)
   - agent_mcp_secure.xml: MCP server auth tokens
   - agent_prefs.xml     : agent chat metadata
   - chat_prefs.xml      : chat history metadata
   Devices older than API 31 follow only this file.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="sharedpref" path="kid_mode_prefs.xml"/>
    <exclude domain="sharedpref" path="agent_mcp_secure.xml"/>
    <exclude domain="sharedpref" path="agent_prefs.xml"/>
    <exclude domain="sharedpref" path="chat_prefs.xml"/>
    <exclude domain="database" path="."/>
</full-backup-content>
