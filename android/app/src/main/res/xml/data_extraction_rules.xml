<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules (API 31+): exclude sensitive data from cloud backup
   and device-to-device transfer.
   - kid_mode_prefs.xml  : kid-mode PIN (even encrypted, avoid copies)
   - agent_mcp_secure.xml: MCP server auth tokens
   - agent_prefs.xml     : agent chat metadata
   - chat_prefs.xml      : chat history metadata
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="kid_mode_prefs.xml"/>
        <exclude domain="sharedpref" path="agent_mcp_secure.xml"/>
        <exclude domain="sharedpref" path="agent_prefs.xml"/>
        <exclude domain="sharedpref" path="chat_prefs.xml"/>
        <exclude domain="database" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="kid_mode_prefs.xml"/>
        <exclude domain="sharedpref" path="agent_mcp_secure.xml"/>
    </device-transfer>
</data-extraction-rules>
